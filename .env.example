# ── Bibliotheca server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ── MySQL ───────────────────────────────────────────────────────────
# Use the bundled local development instance (npm run db:local:start) or
# point these at your own MySQL 8 / MariaDB server.
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASSWORD=
DB_NAME=bibliotheca
DB_CONNECTION_LIMIT=10

# ── Metadata providers ──────────────────────────────────────────────
# Optional. Without a key, Google Books uses its public anonymous quota.
GOOGLE_BOOKS_API_KEY=
METADATA_CACHE_TTL_HOURS=168
METADATA_TIMEOUT_MS=9000

# ── Identification ──────────────────────────────────────────────────
OCR_ENABLED=true
MAX_UPLOAD_MB=12
UPLOAD_DIR=storage

# ── Limits ──────────────────────────────────────────────────────────
IDENTIFY_RATE_LIMIT=15
EXPORT_RATE_LIMIT=30
